# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to `.env.local` (`cp .env.example .env.local`), then run
# `npm run db:start` (or `npx supabase status`) and paste the generated values.

# 1. Direct Postgres connection string used by Drizzle ORM (Database -> URL)
DATABASE_URL=""

# 2. Local Supabase API URL, Publishable Key & Secret Key (used for Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PRIVATE_SUPABASE_SECRET_KEY=""
